# ---- DRISHTI-V backend configuration (copy to .env) ----

# App
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (default: local SQLite; set a PostgreSQL DSN for the full stack)
# DATABASE_URL=postgresql+psycopg://drishti:drishti@localhost:5432/drishti
# DATABASE_URL=sqlite:///./data/drishti.db

# CORS (comma separated). CORS_ALLOW_LAN also permits any private-LAN origin
# (192.168.*, 10.*, 172.16-31.*) so phones/laptops on the same Wi-Fi can connect.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_LAN=true

# AI runtime
AI_DEVICE=auto                 # auto|cpu|cuda
DETECTOR_BACKEND=auto          # auto|yolo|torchvision|motion|null
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.35
DETECTION_IOU=0.5
DETECT_EVERY_N_FRAMES=3
PROCESS_FPS=12

# OCR / ANPR
OCR_ENGINE=easyocr             # easyocr|tesseract|paddleocr
OCR_MIN_CONFIDENCE=0.4
ANPR_VERIFY_CONFIDENCE=0.75
PLATE_COUNTRY=IN

# Enhancement / environment
ENHANCEMENT_ENABLED=true
FOG_SCORE_THRESHOLD=0.45
LOWLIGHT_SCORE_THRESHOLD=0.40

# Speed
DEFAULT_SPEED_LIMIT_KMH=60
SPEED_MIN_CONFIDENCE=0.5

# MongoDB (native / non-Docker live-event store). Start it with
# scripts/setup/setup_mongodb.ps1. The app degrades gracefully if Mongo is down.
MONGODB_ENABLED=true
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=drishti_v
MONGODB_EVENTS_COLLECTION=live_events
MONGODB_TIMEOUT_MS=1500

# Uploads
MAX_UPLOAD_MB=500

# Security (CHANGE IN PRODUCTION)
SECRET_KEY=change-me-in-production
DATA_RETENTION_DAYS=90

# RTSP example (never commit real credentials):
# Add cameras with source_type=rtsp and source_uri=rtsp://user:pass@host:554/stream
